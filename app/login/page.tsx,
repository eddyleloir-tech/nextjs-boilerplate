"use client";
import { useState } from "react";
import { supabase } from "@/lib/supabase";

export default function Login() {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [message, setMessage] = useState("");

  async function connexion() {
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    setMessage(error ? error.message : "Connecté !");
  }

  async function inscription() {
    const { error } = await supabase.auth.signUp({ email, password });
    setMessage(error ? error.message : "Compte créé, vérifiez votre email.");
  }

  return (
    <main className="mx-auto max-w-sm p-6 space-y-4">
      <h1 className="text-2xl font-bold">Connexion</h1>
      <input className="w-full border p-2 rounded" type="email" placeholder="Email" value={email} onChange={(e) => setEmail(e.target.value)} />
      <input className="w-full border p-2 rounded" type="password" placeholder="Mot de passe" value={password} onChange={(e) => setPassword(e.target.value)} />
      <button className="w-full bg-black text-white p-2 rounded" onClick={connexion}>Se connecter</button>
      <button className="w-full border p-2 rounded" onClick={inscription}>Créer un compte</button>
      <p>{message}</p>
    </main>
  );
